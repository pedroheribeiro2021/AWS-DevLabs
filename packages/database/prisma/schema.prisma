generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               UserRole @default(STUDENT)
  hashedRefreshToken String?
  xp                 Int      @default(0)
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastActivityDate   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  progress          UserProgress[]
  labAttempts       LabAttempt[]
  questionAnswers   QuestionAnswer[]
  flashcardProgress UserFlashcardProgress[]
  simulationAttempts SimulationAttempt[]

  @@map("users")
}

model Certification {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examVersions ExamVersion[]

  @@map("certifications")
}

model ExamVersion {
  id                  String    @id @default(cuid())
  certificationId     String
  code                String
  releaseDate         DateTime?
  retirementDate       DateTime?
  questionCount       Int
  durationMinutes     Int
  passingScorePercent Int
  isCurrent           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  certification       Certification       @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  domains             Domain[]
  simulationAttempts  SimulationAttempt[]

  @@unique([certificationId, code])
  @@map("exam_versions")
}

model Domain {
  id            String  @id @default(cuid())
  examVersionId String
  code          String
  name          String
  weightPercent Int
  order         Int     @default(0)

  examVersion ExamVersion @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([examVersionId, code])
  @@map("domains")
}

model Topic {
  id       String @id @default(cuid())
  domainId String
  name     String
  order    Int    @default(0)

  domain              Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  concepts            Concept[]
  learningObjectives  LearningObjective[]
  lessons             Lesson[]
  labs                Lab[]
  questions           Question[]

  @@map("topics")
}

model Lesson {
  id               String @id @default(cuid())
  topicId          String
  title            String
  content          String
  order            Int    @default(0)
  estimatedMinutes Int    @default(10)

  topic     Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  resources LearningResource[]
  progress  UserProgress[]

  @@map("lessons")
}

model LearningResource {
  id       String  @id @default(cuid())
  lessonId String
  title    String
  url      String
  type     String
  order    Int     @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("learning_resources")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model Lab {
  id              String  @id @default(cuid())
  topicId         String
  title           String
  level           Int
  order           Int     @default(0)
  estimatedMinutes Int    @default(30)
  objective       String
  prerequisites   String
  context         String
  troubleshooting String
  cleanup         String
  costWarning     String

  topic     Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  steps     LabStep[]
  attempts  LabAttempt[]

  @@map("labs")
}

model LabStep {
  id           String @id @default(cuid())
  labId        String
  order        Int    @default(0)
  title        String
  instructions String
  validation   String

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@map("lab_steps")
}

model LabAttempt {
  id          String         @id @default(cuid())
  userId      String
  labId       String
  status      ProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@map("lab_attempts")
}

model Concept {
  id          String  @id @default(cuid())
  topicId     String
  name        String
  description String?

  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  awsServices AWSService[]
  flashcards  Flashcard[]

  @@map("concepts")
}

model AWSService {
  id          String  @id @default(cuid())
  name        String  @unique
  shortName   String?
  category    String?
  description String?

  concepts Concept[]

  @@map("aws_services")
}

model LearningObjective {
  id          String @id @default(cuid())
  topicId     String
  description String
  order       Int    @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("learning_objectives")
}

enum QuestionType {
  KNOWLEDGE
  APPLICATION
  SCENARIO
  EXAM_LEVEL
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id                 String             @id @default(cuid())
  topicId            String
  type               QuestionType
  difficulty         QuestionDifficulty
  prompt             String
  explanation        String
  multipleCorrect    Boolean            @default(false)
  officialReferences String?
  order              Int                @default(0)

  topic               Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options             QuestionOption[]
  answers             QuestionAnswer[]
  simulationQuestions SimulationQuestion[]

  @@map("questions")
}

model QuestionOption {
  id          String  @id @default(cuid())
  questionId  String
  text        String
  isCorrect   Boolean @default(false)
  explanation String
  order       Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model QuestionAnswer {
  id                String   @id @default(cuid())
  userId            String
  questionId        String
  selectedOptionIds String[]
  isCorrect         Boolean
  answeredAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_answers")
}

enum FlashcardState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

model Flashcard {
  id        String @id @default(cuid())
  conceptId String
  front     String
  back      String
  order     Int    @default(0)

  concept  Concept                 @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  progress UserFlashcardProgress[]

  @@map("flashcards")
}

model UserFlashcardProgress {
  id           String         @id @default(cuid())
  userId       String
  flashcardId  String
  state        FlashcardState @default(NEW)
  lastReviewedAt DateTime?
  updatedAt    DateTime       @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@map("user_flashcard_progress")
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model SimulationAttempt {
  id              String           @id @default(cuid())
  userId          String
  examVersionId   String
  questionCount   Int
  durationMinutes Int
  status          SimulationStatus @default(IN_PROGRESS)
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  correctCount    Int?
  scorePercent    Int?
  passed          Boolean?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  examVersion ExamVersion          @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  questions   SimulationQuestion[]

  @@map("simulation_attempts")
}

model SimulationQuestion {
  id                  String   @id @default(cuid())
  simulationAttemptId String
  questionId          String
  order               Int
  selectedOptionIds   String[]
  isCorrect           Boolean?
  flagged             Boolean  @default(false)

  simulationAttempt SimulationAttempt @relation(fields: [simulationAttemptId], references: [id], onDelete: Cascade)
  question          Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([simulationAttemptId, questionId])
  @@map("simulation_questions")
}
